APP_NAME=Cellogent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cellogent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Windows/Laragon without Redis: database
# Production + Horizon: redis (Horizon itself always needs Redis running)
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@cellogent.com"
MAIL_FROM_NAME="${APP_NAME}"

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DECAY_SECONDS=600
OTP_EXPOSE_IN_LOCAL=true

SEED_ADMIN_EMAIL=admin@cellogent.com
HORIZON_EMAIL=admin@cellogent.com
# Production: open https://your-host/horizon?token=this-value once, then the session keeps you in.
HORIZON_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

KARIOS_API_ACCESS_KEY=
KARIOS_API_ACCESS_SECRET=
KAIROS_ENV=production
KAIROS_API_VERSION=2025-08-01
KAIROS_LOG_BODIES=true
KAIROS_LOG_DAYS=14

SMS_SYSTEM_SENDER=
SMS_TPS_QUICK=20
SMS_TPS_BULK=100
SMS_TPS_DLR=20
SMS_BULK_REQUEST_SIZE=100
SMS_BULK_JOB_SIZE=2000
SMS_DLR_PER_MINUTE=1000
SMS_LOW_BALANCE_THRESHOLD=10000
SMS_ALERT_EMAILS=
SMS_API_RATE_PER_MINUTE=300

PAYSTACK_SECRET_KEY=sk_test_a5679995ef57939e9410a291ac015ea679c4bb72
PAYSTACK_PUBLIC_KEY=pk_test_a92b460015192324c3073e5fbe9888ad6caaacca
PAYSTACK_CALLBACK_URL=https://terminal.360toursghana.com/api/callbacks/paystack
PAYSTACK_WEBHOOK_URL=https://terminal.360toursghana.com/api/webhooks/paystack

# Kairos Payment API (mobile money). Webhook: {APP_URL}/api/webhooks/kairos-payment?token={KAIROS_PAY_WEBHOOK_TOKEN}
KAIROS_PAY_ENV=production
KAIROS_PAY_USERNAME=
KAIROS_PAY_PASSWORD=
KAIROS_PAY_CALLBACK_ID=
KAIROS_PAY_PAYEE="${APP_NAME}"
KAIROS_PAY_WEBHOOK_TOKEN=

# Browser lands here after card/Paystack checkout (?reference=&status= appended)
PAYMENT_RETURN_URL="${FRONTEND_URL}/payments/complete"
WALLET_TOP_UP_MIN=1
WALLET_TOP_UP_MAX=50000

# SwiftData Ghana Developer API v2 — https://swiftdatagh.shop/api-docs
# (Not the reseller.swiftdatagh.shop API.) Webhook: POST {APP_URL}/api/swift_webhook
SWIFT_API_KEY=
SWIFT_SECRET_KEY=
SWIFT_BASE_URL=https://lsocdjpflecduumopijn.supabase.co/functions/v1/developer-api
SWIFT_VERIFY_URL=https://lsocdjpflecduumopijn.supabase.co/functions/v1/verify-beneficiary
SWIFT_TIMEOUT=30
SWIFT_CONNECT_TIMEOUT=5
SWIFT_MARKUP_PERCENT=0
# Swift has no price list for results checkers: our cost per voucher (GHS).
SWIFT_RESULTS_WASSCE_COST=17
SWIFT_RESULTS_BECE_COST=17
# Register {APP_URL}/api/swift_webhook with Swift; with SWIFT_SECRET_KEY set it must be signed (X-Swift-Signature).